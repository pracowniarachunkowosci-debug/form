# Install only in the dedicated production vhost AFTER G1-G8.
Options -Indexes
DirectoryIndex index.html
AddType image/avif .avif
AddType image/webp .webp
RewriteEngine On
# Do not expose an RC or production tree through the technical hostname.
RewriteCond %{HTTP_HOST} !^(www\.)?pracowniaform\.com(:[0-9]+)?$ [NC]
RewriteRule ^ - [F]
# Keep ACME challenges reachable during issuance/renewal.
RewriteRule ^\.well-known/acme-challenge/ - [L]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^pracowniaform\.com$ [NC]
RewriteRule ^ https://pracowniaform.com%{REQUEST_URI} [R=301,L]
